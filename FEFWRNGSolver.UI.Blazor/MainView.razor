@using FEFWRNGSolver.Domain
@using FEFWRNGSolver.Presentation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@implements IAsyncDisposable

<fieldset class="unit-panel" disabled="@m_Search.IsRunning">
    <legend>@Text["SYS_UNIT"]</legend>
    <div class="unit-fields">
        <GrowthSettings Model="m_ViewModel" SettingsChanged="m_Search.InputsChanged" />
    </div>
</fieldset>
@if (m_Store.ErrorMessage is not null)
{
    <p role="alert">@m_Store.ErrorMessage</p>
}
<div class="tool-tabs" role="tablist" aria-label="@Text["SYS_TOOLS"]" @onkeydown="OnTabKeyDown">
    <button type="button" role="tab" id="seed-tab" aria-controls="seed-panel"
            aria-selected="@(m_ShowPrediction ? "false" : "true")" tabindex="@(m_ShowPrediction ? -1 : 0)"
            @ref="m_SeedTab" @onclick="() => m_ShowPrediction = false">@Text["SYS_SEARCH_TAB"]</button>
    <button type="button" role="tab" id="prediction-tab" aria-controls="prediction-panel"
            aria-selected="@(m_ShowPrediction ? "true" : "false")" tabindex="@(m_ShowPrediction ? 0 : -1)"
            @ref="m_PredictionTab" @onclick="() => m_ShowPrediction = true">@Text["SYS_PREDICTION_TAB"]</button>
</div>
<section id="prediction-panel" role="tabpanel" aria-labelledby="prediction-tab" hidden="@(!m_ShowPrediction)">
    <h2>@Text["SYS_PREDICTION_TAB"]</h2>
    <form @onsubmit="Calculate" @onsubmit:preventDefault>
        <div class="prediction-settings">
            <label>@Text["SYS_GROWTH_SEED_INPUT"]
                <input class="seed" @bind="m_ViewModel.GrowthSeed" @bind:event="oninput"
                       placeholder="@Text["SYS_GROWTH_SEED_EXAMPLE"]" spellcheck="false" autocapitalize="characters" />
            </label>
            <label>@Text["SYS_MAX_RNG_ADVANCES"]
                <input @bind="m_ViewModel.MaxAdvances" @bind:event="oninput" inputmode="numeric" />
            </label>
        </div>
        <fieldset>
            <legend>@Text["SYS_PREDICTION_FILTER"]</legend>
            <div class="growth-conditions">
                @foreach (var stat in m_ViewModel.GrowthRates)
                {
                    <label>@stat.Name
                        <select @bind="stat.Condition">
                            @foreach (var option in m_ViewModel.GrowthConditionOptions)
                            {
                                <option value="@option.Value">@option.Name</option>
                            }
                        </select>
                    </label>
                }
            </div>
            <div class="growth-count" role="group" aria-labelledby="growth-count-label">
                <span id="growth-count-label">@Text["SYS_FILTER_GROWTH_COUNT"]</span>
                <input type="number" min="0" max="9" required aria-label="@Text["SYS_FILTER_MIN_GROWTH_COUNT"]"
                       @bind="m_ViewModel.MinGrowthCount" @bind:event="oninput" />
                <span aria-hidden="true">～</span>
                <input type="number" min="0" max="9" required aria-label="@Text["SYS_FILTER_MAX_GROWTH_COUNT"]"
                       @bind="m_ViewModel.MaxGrowthCount" @bind:event="oninput" />
            </div>
            <div class="class-change-controls">
                <label><input type="checkbox" @bind="m_ViewModel.ConsiderClassChanges" disabled="@m_ViewModel.Setup.IsManual" />
                    @Text["SYS_CONSIDER_CLASS_CHANGES"]
                </label>
                <button type="button" class="secondary" disabled="@m_ViewModel.Setup.IsManual"
                        aria-expanded="@(m_ShowClassSettings ? "true" : "false")" aria-controls="prediction-class-settings"
                        @onclick="() => m_ShowClassSettings = !m_ShowClassSettings">@Text["SYS_SETTINGS"]</button>
            </div>
            <div id="prediction-class-settings" class="class-settings">
                @if (m_ShowClassSettings)
                {
                    <div class="class-tiers">
                        @foreach (var group in m_ViewModel.Setup.PredictionClassGroups)
                        {
                            <fieldset>
                                <legend>@group.Name</legend>
                                @foreach (var job in group.Classes)
                                {
                                    var selected = m_ViewModel.IsPredictionClassSelected(job.Id);
                                    var settings = m_ViewModel.GetPredictionSettings(job.Id);
                                    var showSettings = selected && job.IsAvailable;
                                    <div @key="job.Id" role="group" aria-label="@job.Name">
                                        <label class="class-choice">
                                            <input type="checkbox" disabled="@(!job.IsAvailable)"
                                                   @bind:get="selected"
                                                   @bind:set="(bool value) => m_ViewModel.SetPredictionClassSelected(job.Id, value)" />
                                            @job.Name
                                        </label>
                                        @if (showSettings && m_ViewModel.GetPredictionSkillOptions(job.Id) is { Count: > 1 } skills)
                                        {
                                            <label class="class-setting">@Text["SYS_SKILL_BONUS"]
                                                <select @bind:get="settings.SkillBonus"
                                                        @bind:set="(GrowthSkillBonus? value) => m_ViewModel.SetPredictionSettings(job.Id, settings with { SkillBonus = value })">
                                                    <option value="">@Text["SYS_USE_UNIT_SETTINGS"]</option>
                                                    @foreach (var skill in skills)
                                                    {
                                                        <option value="@skill.Value">@skill.Name</option>
                                                    }
                                                </select>
                                            </label>
                                        }
                                        @if (showSettings && m_ViewModel.GetPredictionAnimalOptions(job.Id) is { Count: > 1 } animals)
                                        {
                                            <div class="class-animal">
                                                <label class="class-setting">@Text["SYS_ANIMAL"]
                                                    <select @bind:get="settings.AnimalId ?? UseUnitAnimal"
                                                            @bind:set="(string? value) => m_ViewModel.SetPredictionSettings(job.Id, settings with { AnimalId = value == UseUnitAnimal ? null : value })">
                                                        <option value="@UseUnitAnimal">@Text["SYS_USE_UNIT_SETTINGS"]</option>
                                                        @foreach (var animal in animals)
                                                        {
                                                            <option value="@animal.Id">@animal.Name</option>
                                                        }
                                                    </select>
                                                </label>
                                                @if (!string.IsNullOrEmpty(settings.AnimalId))
                                                {
                                                    <label class="class-setting">@Text["SYS_AFFECTION"]
                                                        <select @bind:get="settings.Affection"
                                                                @bind:set="(int value) => m_ViewModel.SetPredictionSettings(job.Id, settings with { Affection = value })">
                                                            @foreach (var level in GrowthSetupViewModel.AffectionLevels)
                                                            {
                                                                <option value="@level">@level</option>
                                                            }
                                                        </select>
                                                    </label>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </fieldset>
                        }
                    </div>
                }
            </div>
        </fieldset>
        @if (m_ViewModel.ErrorMessage is not null)
        {
            <p role="alert">@m_ViewModel.ErrorMessage</p>
        }
        @if (m_ExportErrorKey is not null)
        {
            <p role="alert">@Text[m_ExportErrorKey]</p>
        }
        <div class="prediction-actions">
            <button type="submit">@Text["SYS_CALCULATE"]</button>
            <div class="prediction-export">
                <button type="button" class="secondary" disabled="@(!CanExport)" @onclick="() => ExportCsv(false)">@Text["SYS_COPY"]</button>
                <button type="button" class="secondary" disabled="@(!CanExport)" @onclick="() => ExportCsv(true)">@Text["SYS_SAVE"]</button>
            </div>
        </div>
    </form>

    <h3>@Text["SYS_PREDICTION_RESULTS"]</h3>
    <div class="table-scroll" @key="m_ViewModel.Results" tabindex="0" role="region" aria-label="@Text["SYS_PREDICTION_RESULTS_REGION"]">
        <table>
            <thead>
                <tr>
                    <th scope="col">@Text["SYS_RNG_ADVANCES"]</th>
                    <th scope="col">@Text["SYS_JOB"]</th>
                    <th scope="col">@Text["SYS_GROWTH_SEED"]</th>
                    <th scope="col" class="compact-column" @attributes="@(Tooltip.For(Text["SYS_EXAM_MIN_PASS_RATE_TOOLTIP"]))">
                        @Text["SYS_EXAM"]
                    </th>
                    @foreach (var stat in m_ViewModel.GrowthRates)
                    {
                        <th scope="col">@stat.Name</th>
                    }
                    <th scope="col">@Text["SYS_NEXT_GROWTH_SEED"]</th>
                </tr>
            </thead>
            <tbody>
                @if (m_ViewModel.Results.Count == 0)
                {
                    <tr><td class="empty" colspan="14">@Text[m_ViewModel.HasCalculated ? "SYS_PREDICTION_NO_MATCHES" : "SYS_PREDICTION_EMPTY"]</td></tr>
                }
                else
                {
                    <Virtualize TItem="LevelUpRow" ItemsProvider="GetRows" Context="row" ItemSize="40" SpacerElement="tr">
                        <tr @key="(row.Advances, row.ClassId)">
                            <td>@row.Advances</td>
                            <td>@Text.Job(row.ClassId)</td>
                            <SeedCell Seed="@row.GrowthSeed" SeedAdopted="AdoptSeed" />
                            <td>@Text.Format("SYS_EXAM_MIN_PASS_RATE", row.MinimumExamPassRate)</td>
                            @foreach (var gain in row.StatGains)
                            {
                                <td class="@(gain > 0 ? "gain" : null)">@gain.ToString("+0;−0;0")</td>
                            }
                            <SeedCell Seed="@row.NextGrowthSeed" SeedAdopted="AdoptSeed" />
                        </tr>
                    </Virtualize>
                }
            </tbody>
        </table>
    </div>
</section>
<section id="seed-panel" role="tabpanel" aria-labelledby="seed-tab" hidden="@m_ShowPrediction">
    <SeedSearchView Model="m_Search" SeedAdopted="AdoptSeed" />
</section>

@code {
    private const string UseUnitAnimal = "__unit__";
    [CascadingParameter] public LocalizationCatalog Text { get; set; } = null!;
    private BrowserUnitSettingsStore m_Store = null!;
    private SeedSearchViewModel m_Search = null!;
    private MainViewModel m_ViewModel => m_Search.Settings;
    private bool m_ShowPrediction;
    private bool m_ShowClassSettings;
    private ElementReference m_PredictionTab;
    private ElementReference m_SeedTab;
    private IJSObjectReference? m_ExportModule;
    private string? m_ExportErrorKey;
    private bool CanExport => m_ViewModel.HasCalculated && m_ExportModule is not null;

    protected override async Task OnInitializedAsync()
    {
        m_Store = new((IJSInProcessRuntime)JavaScript, Text);
        m_Search = new(m_Store, Text);
        m_Search.Changed += Refresh;
        m_ViewModel.UnitSelected += OnUnitSelected;
        m_ExportModule = await JavaScript.InvokeAsync<IJSObjectReference>("import",
            "./_content/FEFWRNGSolver.UI.Blazor/MainView.razor.js");
    }

    private void OnUnitSelected()
    {
        m_ShowPrediction = m_ViewModel.GrowthSeed.Length > 0;
        m_ShowClassSettings = false;
        m_ExportErrorKey = null;
    }

    private async Task AdoptSeed(uint seed)
    {
        m_ViewModel.AdoptGrowthSeed(seed);
        m_ShowPrediction = true;
        await m_PredictionTab.FocusAsync();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        m_ViewModel.UnitSelected -= OnUnitSelected;
        m_Search.Changed -= Refresh;
        m_Search.Cancel();
        if (m_ExportModule is not null)
            await m_ExportModule.DisposeAsync();
    }

    private async Task OnTabKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowLeft":
            case "ArrowRight":
                m_ShowPrediction = !m_ShowPrediction;
                break;
            case "Home":
                m_ShowPrediction = false;
                break;
            case "End":
                m_ShowPrediction = true;
                break;
            default:
                return;
        }

        await (m_ShowPrediction ? m_PredictionTab : m_SeedTab).FocusAsync();
    }

    private void Calculate()
    {
        m_ExportErrorKey = null;
        m_ViewModel.Calculate();
    }

    private async Task ExportCsv(bool save)
    {
        m_ExportErrorKey = null;
        using var source = DotNetObjectReference.Create(this);
        try
        {
            if (save)
                await m_ExportModule!.InvokeVoidAsync("saveCsv", source, m_ViewModel.PredictionCsvFileName,
                    Text["SYS_CSV_FILE"], Text["SYS_CSV_FILENAME"]);
            else
                await m_ExportModule!.InvokeVoidAsync("copyCsv", source);
        }
        catch (JSException)
        {
            m_ExportErrorKey = save ? "SYS_CSV_SAVE_ERROR" : "SYS_COPY_ERROR";
        }
    }

    [JSInvokable]
    public string CreatePredictionCsv() => m_ViewModel.CreatePredictionCsv();

    private ValueTask<ItemsProviderResult<LevelUpRow>> GetRows(ItemsProviderRequest request)
    {
        var results = m_ViewModel.Results;
        return ValueTask.FromResult(new ItemsProviderResult<LevelUpRow>(
            results.Skip(request.StartIndex).Take(request.Count), results.Count));
    }
}
