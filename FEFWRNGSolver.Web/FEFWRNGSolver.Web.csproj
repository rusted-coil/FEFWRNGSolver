<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BlazorIcuDataFileName>icudt_CJK.dat</BlazorIcuDataFileName>
    <!-- Serve the editable dictionaries directly, including after a post-publish edit. -->
    <CompressionExcludePatterns>$(CompressionExcludePatterns);languages/**/*.json</CompressionExcludePatterns>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.13" PrivateAssets="all" />
    <ProjectReference Include="../FEFWRNGSolver.UI.Blazor/FEFWRNGSolver.UI.Blazor.csproj" />
  </ItemGroup>
</Project>
