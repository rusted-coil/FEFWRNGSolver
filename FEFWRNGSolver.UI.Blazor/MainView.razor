@using FEFWRNGSolver.Presentation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Web.Virtualization
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@implements IDisposable

<PageTitle>@m_ViewModel.Title</PageTitle>
<fieldset class="unit-panel" disabled="@m_Search.IsRunning">
    <legend>@Text["SYS_UNIT"]</legend>
    <div class="unit-fields">
        <GrowthSettings Model="m_ViewModel" SettingsChanged="m_Search.InputsChanged" />
    </div>
</fieldset>
@if (m_Store.ErrorMessage is not null)
{
    <p role="alert">@m_Store.ErrorMessage</p>
}
<div class="tool-tabs" role="tablist" aria-label="@Text["SYS_TOOLS"]" @onkeydown="OnTabKeyDown">
    <button type="button" role="tab" id="seed-tab" aria-controls="seed-panel"
            aria-selected="@(m_ShowPrediction ? "false" : "true")" tabindex="@(m_ShowPrediction ? -1 : 0)"
            @ref="m_SeedTab" @onclick="() => m_ShowPrediction = false">@Text["SYS_SEARCH_TAB"]</button>
    <button type="button" role="tab" id="prediction-tab" aria-controls="prediction-panel"
            aria-selected="@(m_ShowPrediction ? "true" : "false")" tabindex="@(m_ShowPrediction ? 0 : -1)"
            @ref="m_PredictionTab" @onclick="() => m_ShowPrediction = true">@Text["SYS_PREDICTION_TAB"]</button>
</div>
<section id="prediction-panel" role="tabpanel" aria-labelledby="prediction-tab" hidden="@(!m_ShowPrediction)">
    <h1>@Text["SYS_PREDICTION_HEADING"]</h1>
    <form @onsubmit="Calculate" @onsubmit:preventDefault>
        <div class="prediction-settings">
            <label>@Text["SYS_GROWTH_SEED_INPUT"]
                <input class="seed" @bind="m_ViewModel.GrowthSeed" @bind:event="oninput"
                       placeholder="@Text["SYS_GROWTH_SEED_EXAMPLE"]" spellcheck="false" autocapitalize="characters" />
            </label>
            <label>@Text["SYS_LEVEL_UP_COUNT"]
                <input @bind="m_ViewModel.LevelUpCount" @bind:event="oninput" inputmode="numeric" />
            </label>
        </div>
        <fieldset>
            <legend>@Text["SYS_PREDICTION_FILTER"]</legend>
            <div class="growth-conditions">
                @foreach (var stat in m_ViewModel.GrowthRates)
                {
                    <label>@stat.Name
                        <select @bind="stat.Condition">
                            @foreach (var option in m_ViewModel.GrowthConditionOptions)
                            {
                                <option value="@option.Value">@option.Name</option>
                            }
                        </select>
                    </label>
                }
            </div>
            <div class="growth-count" role="group" aria-labelledby="growth-count-label">
                <span id="growth-count-label">@Text["SYS_FILTER_GROWTH_COUNT"]</span>
                <input type="number" min="0" max="9" required aria-label="@Text["SYS_FILTER_MIN_GROWTH_COUNT"]"
                       @bind="m_ViewModel.MinGrowthCount" @bind:event="oninput" />
                <span aria-hidden="true">～</span>
                <input type="number" min="0" max="9" required aria-label="@Text["SYS_FILTER_MAX_GROWTH_COUNT"]"
                       @bind="m_ViewModel.MaxGrowthCount" @bind:event="oninput" />
            </div>
        </fieldset>
        <p>@Text["SYS_PREDICTION_RULES"]</p>
        @if (m_ViewModel.ErrorMessage is not null)
        {
            <p role="alert">@m_ViewModel.ErrorMessage</p>
        }
        <button type="submit">@Text["SYS_CALCULATE"]</button>
    </form>

    <h2>@Text["SYS_PREDICTION_RESULTS"]</h2>
    <div class="table-scroll" @key="m_ViewModel.Results" tabindex="0" role="region" aria-label="@Text["SYS_PREDICTION_RESULTS_REGION"]">
        <table>
            <thead>
                <tr>
                    <th scope="col">@Text["SYS_LEVEL_NUMBER"]</th>
                    <th scope="col">@Text["SYS_GROWTH_SEED"]</th>
                    @foreach (var stat in m_ViewModel.GrowthRates)
                    {
                        <th scope="col">@stat.Name</th>
                    }
                    <th scope="col">@Text["SYS_NEXT_GROWTH_SEED"]</th>
                </tr>
            </thead>
            <tbody>
                @if (m_ViewModel.Results.Count == 0)
                {
                    <tr><td class="empty" colspan="12">@Text[m_ViewModel.HasCalculated ? "SYS_PREDICTION_NO_MATCHES" : "SYS_PREDICTION_EMPTY"]</td></tr>
                }
                else
                {
                    <Virtualize TItem="LevelUpRow" ItemsProvider="GetRows" Context="row" ItemSize="40" SpacerElement="tr">
                        <tr @key="row.Number">
                            <td>@row.Number</td>
                            <SeedCell Seed="@row.GrowthSeed" SeedAdopted="AdoptSeed" />
                            @foreach (var gain in row.StatGains)
                            {
                                <td class="@(gain > 0 ? "gain" : null)">@gain.ToString("+0;−0;0")</td>
                            }
                            <SeedCell Seed="@row.NextGrowthSeed" SeedAdopted="AdoptSeed" />
                        </tr>
                    </Virtualize>
                }
            </tbody>
        </table>
    </div>
</section>
<section id="seed-panel" role="tabpanel" aria-labelledby="seed-tab" hidden="@m_ShowPrediction">
    <SeedSearchView Model="m_Search" SeedAdopted="AdoptSeed" />
</section>

@code {
    [CascadingParameter] public LocalizationCatalog Text { get; set; } = null!;
    private BrowserUnitSettingsStore m_Store = null!;
    private SeedSearchViewModel m_Search = null!;
    private MainViewModel m_ViewModel => m_Search.Settings;
    private bool m_ShowPrediction;
    private ElementReference m_PredictionTab;
    private ElementReference m_SeedTab;

    protected override void OnInitialized()
    {
        m_Store = new((IJSInProcessRuntime)JavaScript, Text);
        m_Search = new(m_Store, Text);
        m_Search.Changed += Refresh;
        m_ViewModel.UnitSelected += OnUnitSelected;
    }

    private void OnUnitSelected() => m_ShowPrediction = m_ViewModel.GrowthSeed.Length > 0;

    private async Task AdoptSeed(uint seed)
    {
        m_ViewModel.AdoptGrowthSeed(seed);
        m_ShowPrediction = true;
        await m_PredictionTab.FocusAsync();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        m_ViewModel.UnitSelected -= OnUnitSelected;
        m_Search.Changed -= Refresh;
        m_Search.Cancel();
    }

    private async Task OnTabKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "ArrowLeft":
            case "ArrowRight":
                m_ShowPrediction = !m_ShowPrediction;
                break;
            case "Home":
                m_ShowPrediction = false;
                break;
            case "End":
                m_ShowPrediction = true;
                break;
            default:
                return;
        }

        await (m_ShowPrediction ? m_PredictionTab : m_SeedTab).FocusAsync();
    }

    private void Calculate() => m_ViewModel.Calculate();

    private ValueTask<ItemsProviderResult<LevelUpRow>> GetRows(ItemsProviderRequest request)
    {
        var results = m_ViewModel.Results;
        return ValueTask.FromResult(new ItemsProviderResult<LevelUpRow>(
            results.Skip(request.StartIndex).Take(request.Count), results.Count));
    }
}
