@using FEFWRNGSolver.Presentation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@{ var gainOptions = Model.GetGainOptions(); }

<h1>成長seed特定</h1>
<form @onsubmit="Search" @onsubmit:preventDefault>
    <fieldset class="search-inputs" disabled="@Model.IsRunning">
        <h2>観測したレベルアップ</h2>
        <p>同じ成長条件での抽選成長（最低保証2種類）を1回目から順に入力してください。
            各能力が上限に達せず、途中でほかの行動が成長seedを消費していない連続した区間が対象です。</p>
        <p>チェックで各能力の上昇量を切り替えられます。</p>
        <div class="table-scroll" tabindex="0" role="region" aria-label="各回の能力上昇量">
            <table class="observations">
                <thead>
                    <tr>
                        <th scope="col">回数</th>
                        @foreach (var stat in Model.Settings.GrowthRates)
                        {
                            <th scope="col">@stat.Name</th>
                        }
                        <th scope="col">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Observations.Count; i++)
                    {
                        var rowIndex = i;
                        var row = Model.Observations[i];
                        <tr @key="row">
                            <th scope="row">@(i + 1)</th>
                            @for (int j = 0; j < row.Length; j++)
                            {
                                var column = j;
                                var (low, high) = gainOptions[j];
                                <td>
                                    <label>
                                        <input type="checkbox" @bind="row[column]" @bind:after="Model.InputsChanged"
                                               disabled="@(low == high)"
                                               aria-label="@($"{i + 1}回目の{Model.Settings.GrowthRates[j].Name}の追加上昇")" />
                                        +@(row[column] ? high : low)
                                    </label>
                                </td>
                            }
                            <td><button type="button" class="secondary"
                                        aria-label="@($"{i + 1}回目を削除")" @onclick="() => Model.RemoveObservation(rowIndex)">削除</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <button class="secondary add-observation" type="button" @onclick="Model.AddObservation">レベルアップを追加</button>
    </fieldset>
    @if (Model.ErrorMessage is not null)
    {
        <p role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.IsRunning)
    {
        <button type="button" @onclick="Model.Cancel">探索を中止</button>
    }
    else
    {
        <button type="submit">計算</button>
    }
</form>

@if (Model.IsRunning || Model.HasCompleted || Model.WasCancelled)
{
    <h2>探索結果</h2>
    <p role="status">@SearchStatus</p>
    <label class="search-progress">探索済み @Model.Scanned.ToString("N0") / @SeedSearchViewModel.CandidateCount.ToString("N0")
        <progress value="@Model.Scanned" max="@SeedSearchViewModel.CandidateCount"></progress>
    </label>
    <p>
        一致した候補は @Model.MatchCount.ToString("N0") 件です。
        @if (Model.MatchCount > Model.Matches.Count)
        {
            <text>先頭 @Model.Matches.Count 件を表示します。</text>
        }
    </p>
    @if (Model.Matches.Count > 0)
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="一致した成長seedの候補">
            <table>
                <thead><tr><th scope="col">観測開始時の成長seed</th><th scope="col">観測終了後の成長seed</th></tr></thead>
                <tbody>
                    @foreach (var match in Model.Matches)
                    {
                        <tr><td class="seed">@match.InitialSeed.ToString("X8")</td><td class="seed">@match.NextSeed.ToString("X8")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter, EditorRequired] public SeedSearchViewModel Model { get; set; } = null!;

    private string SearchStatus => Model.IsRunning
        ? Model.WorkerCount > 0 ? $"探索中（並列数 {Model.WorkerCount}）" : "探索準備中"
        : Model.HasCompleted ? "探索完了" : "探索中断";

    private Task Search() => Model.SearchWithWorkersAsync((rates, observations, token) =>
        BrowserSeedSearchPool.CreateAsync(JavaScript, rates, observations, token));
}
