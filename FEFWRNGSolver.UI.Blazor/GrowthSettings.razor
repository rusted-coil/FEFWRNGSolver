@using FEFWRNGSolver.Presentation
@using Microsoft.AspNetCore.Components.Web

@{
    var setup = Model.Setup;
    var skillOptions = Model.SkillOptions;
}
<div class="unit-selectors">
    <label>@Text["SYS_UNIT"]
        <select @key="Text.Code" @bind="setup.UnitId" @bind:after="NotifyChanged">
            @foreach (var unit in setup.Units)
            {
                <option value="@unit.Id">@unit.Name</option>
            }
        </select>
    </label>
    <label>@Text["SYS_JOB"]
        <select @key="setup.UnitId" @bind="setup.ClassId" @bind:after="NotifyChanged" disabled="@setup.IsManual">
            @foreach (var job in setup.Classes)
            {
                <option value="@job.Id">@job.Name</option>
            }
        </select>
    </label>
    <label>@Text["SYS_ANIMAL"]
        <select @key="(setup.UnitId, setup.ClassId)" @bind="setup.AnimalId" @bind:after="NotifyChanged" disabled="@(setup.Animals.Count <= 1)">
            @foreach (var animal in setup.Animals)
            {
                <option value="@animal.Id">@animal.Name</option>
            }
        </select>
    </label>
    <label>@Text["SYS_AFFECTION"]
        <select @bind="setup.Affection" @bind:after="NotifyChanged" disabled="@(!setup.HasAnimal)">
            @foreach (var level in GrowthSetupViewModel.AffectionLevels)
            {
                <option value="@level">@level</option>
            }
        </select>
    </label>
    <label>@Text["SYS_SKILL_BONUS"]
        <select @key="setup.ClassId" @bind="Model.SelectedSkillBonus" @bind:after="NotifyChanged" disabled="@(skillOptions.Count <= 1)">
            @foreach (var option in skillOptions)
            {
                <option value="@option.Value">@option.Name</option>
            }
        </select>
    </label>
    <label class="part-three">
        <input type="checkbox" @bind="Model.IsPartThree" @bind:after="NotifyChanged" disabled="@(!Model.CanSelectPartThree)" />
        @Text["SYS_PART_THREE"]
    </label>
</div>
<div class="growth-inputs">
    <fieldset>
        <legend>@Text["SYS_GROWTH_RATES"]</legend>
        <div class="rates">
            @foreach (var stat in Model.GrowthRates)
            {
                <label>@stat.Name
                    <input @bind="stat.Rate" @bind:event="oninput" @bind:after="NotifyChanged" inputmode="numeric" />
                </label>
            }
        </div>
    </fieldset>
    <label class="guaranteed-count">@Text["SYS_GUARANTEED_STAT_COUNT"]
        <input @bind="Model.GuaranteedStatCount" @bind:event="oninput" @bind:after="NotifyChanged"
               inputmode="numeric" readonly="@(!setup.IsManual)" />
    </label>
</div>

@code {
    [CascadingParameter] public LocalizationCatalog Text { get; set; } = null!;
    [Parameter, EditorRequired] public MainViewModel Model { get; set; } = null!;
    [Parameter] public EventCallback SettingsChanged { get; set; }

    private Task NotifyChanged() => SettingsChanged.InvokeAsync();
}
