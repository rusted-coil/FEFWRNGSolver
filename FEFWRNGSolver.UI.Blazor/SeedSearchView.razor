@using FEFWRNGSolver.Presentation
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JavaScript
@{ var gainOptions = Model.GetGainOptions(); }

<h1>@Text["SYS_SEARCH_TAB"]</h1>
<form @onsubmit="Search" @onsubmit:preventDefault>
    <fieldset class="search-inputs" disabled="@Model.IsRunning">
        <h2>@Text["SYS_SEARCH_OBSERVATIONS"]</h2>
        <p>@Text["SYS_OBSERVATION_GUIDE"]</p>
        <div class="observation-actions">
            <button type="button" class="secondary" @onclick="AddObservation">@Text["SYS_ADD_OBSERVATION"]</button>
            <button type="button" class="secondary" @onclick="RemoveSelectedObservation"
                    disabled="@(Model.Observations.Count == 0)">@Text["SYS_REMOVE_SELECTED_ROW"]</button>
        </div>
        <div class="table-scroll" tabindex="0" role="region" aria-label="@Text["SYS_OBSERVATIONS_REGION"]">
            <table class="observations">
                <thead>
                    <tr>
                        <th scope="col">@Text["SYS_LEVEL_NUMBER"]</th>
                        @foreach (var stat in Model.Settings.GrowthRates)
                        {
                            <th scope="col">@stat.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Observations.Count; i++)
                    {
                        var rowIndex = i;
                        var row = Model.Observations[i];
                        <tr @key="row" class="@(m_SelectedRow == rowIndex ? "selected-row" : null)"
                            @onclick="() => SelectRow(rowIndex)">
                            <th scope="row">
                                <label>
                                    <input type="radio" name="selected-observation" checked="@(m_SelectedRow == rowIndex)"
                                           @onchange="() => SelectRow(rowIndex)" aria-label="@Text.Format("SYS_SELECT_OBSERVATION", i + 1)" />
                                    @(i + 1)
                                </label>
                            </th>
                            @for (int j = 0; j < row.Length; j++)
                            {
                                var column = j;
                                var (low, high) = gainOptions[j];
                                <td>
                                    <label>
                                        <input type="checkbox" @bind:get="(low == high ? low > 0 : row[column])"
                                               @bind:set="(bool gained) => { row[column] = gained; Model.InputsChanged(); }"
                                               disabled="@(low == high)"
                                               aria-label="@Text.Format("SYS_OBSERVATION_GAIN", i + 1, Model.Settings.GrowthRates[j].Name)" />
                                    </label>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </fieldset>
    @if (Model.ErrorMessage is not null)
    {
        <p role="alert">@Model.ErrorMessage</p>
    }
    @if (Model.IsRunning)
    {
        <button type="button" @onclick="Model.Cancel">@Text["SYS_CANCEL_SEARCH"]</button>
    }
    else
    {
        <button type="submit">@Text["SYS_CALCULATE"]</button>
    }
</form>

@if (Model.IsRunning || Model.HasCompleted || Model.WasCancelled)
{
    <h2>@Text["SYS_SEARCH_RESULTS"]</h2>
    <p role="status">@SearchStatus</p>
    <label class="search-progress">@Text.Format("SYS_SEARCH_PROGRESS", Model.Scanned, SeedSearchViewModel.CandidateCount)
        <progress value="@Model.Scanned" max="@SeedSearchViewModel.CandidateCount"></progress>
    </label>
    <p>
        @Text.Format("SYS_SEARCH_MATCHES", Model.MatchCount)
        @if (Model.MatchCount > Model.Matches.Count)
        {
            @Text.Format("SYS_SEARCH_MATCH_LIMIT", Model.Matches.Count)
        }
    </p>
    @if (Model.Matches.Count > 0)
    {
        <div class="table-scroll" tabindex="0" role="region" aria-label="@Text["SYS_MATCHES_REGION"]">
            <table>
                <thead><tr><th scope="col">@Text["SYS_MATCH_INITIAL"]</th><th scope="col">@Text["SYS_MATCH_NEXT"]</th></tr></thead>
                <tbody>
                    @foreach (var match in Model.Matches)
                    {
                        <tr @key="match.InitialSeed">
                            <SeedCell Seed="@(match.InitialSeed.ToString("X8"))" SeedAdopted="SeedAdopted" />
                            <SeedCell Seed="@(match.NextSeed.ToString("X8"))" SeedAdopted="SeedAdopted" />
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [CascadingParameter] public LocalizationCatalog Text { get; set; } = null!;
    [Parameter, EditorRequired] public SeedSearchViewModel Model { get; set; } = null!;
    [Parameter] public EventCallback<uint> SeedAdopted { get; set; }
    private int m_SelectedRow;

    private void SelectRow(int index)
    {
        if (!Model.IsRunning)
            m_SelectedRow = index;
    }

    private void AddObservation()
    {
        Model.AddObservation();
        m_SelectedRow = Model.Observations.Count - 1;
    }

    private void RemoveSelectedObservation()
    {
        if (m_SelectedRow >= 0 && m_SelectedRow < Model.Observations.Count)
        {
            Model.RemoveObservation(m_SelectedRow);
            m_SelectedRow = Math.Min(m_SelectedRow, Model.Observations.Count - 1);
        }
    }

    private string SearchStatus => Model.IsRunning
        ? Model.WorkerCount > 0 ? Text.Format("SYS_SEARCH_RUNNING", Model.WorkerCount) : Text["SYS_SEARCH_PREPARING"]
        : Text[Model.HasCompleted ? "SYS_SEARCH_COMPLETED" : "SYS_SEARCH_CANCELLED"];

    private Task Search() => Model.SearchWithWorkersAsync((rates, observations, targetStatCount, token) =>
        BrowserSeedSearchPool.CreateAsync(JavaScript, rates, observations, targetStatCount, token));
}
